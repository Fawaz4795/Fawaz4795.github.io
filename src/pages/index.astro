    <meta charset="utf-8" />
    <title>Mohammed Fawaz — Engineering Portfolio</title>
  </head>
  <body>
    <div class="page">
      <header class="masthead">
        <h1>MOHAMMED FAWAZ</h1>
        <p>Robotics & Automation Engineering — Edge AI · Computer Vision · Mechanical Design</p>
      </header>

      {projects.map((p) => <ProjectSheet project={p} />)}
    </div>
  </body>
</html>