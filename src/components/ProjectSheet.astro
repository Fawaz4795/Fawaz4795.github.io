---
const { project } = Astro.props;
---
<article class="sheet">
  <header class="title-block">
    <div class="tb-row">
      <span class="tb-label">PROJECT</span>
      <span class="tb-value">{project.name}</span>
    </div>
    <div class="tb-row">
      <span class="tb-label">DOMAIN</span>
      <span class="tb-value">{project.domain}</span>
    </div>
    <div class="tb-row tb-split">
      <div><span class="tb-label">PERIOD</span> <span class="tb-value">{project.period}</span></div>
      {project.context && <div><span class="tb-label">CONTEXT</span> <span class="tb-value">{project.context}</span></div>}
    </div>
  </header>

  <p class="tagline">{project.tagline}</p>

  <div class="pipeline">
    {project.pipeline.map((step, i) => (
      <>
        <span class="pipe-step">{step}</span>
        {i < project.pipeline.length - 1 && <span class="pipe-arrow">→</span>}
      </>
    ))}
  </div>

  <div class="metrics">
    {project.metrics.map((m) => (
      <div class="metric">
        <div class="metric-value">{m.value}</div>
        <div class="metric-label">{m.label}</div>
      </div>
    ))}
  </div>

  <div class="summary">
    {project.summary.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
  </div>

  {project.gallery?.length > 0 && (
    <section class="project-gallery" aria-label="Project images">
      {project.gallery.map((image) => (
        <figure>
          <a href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`${image.caption} Open full-size image in a new tab.`}>
            <img src={image.src} alt={image.caption} loading="lazy" decoding="async" />
          </a>
          <figcaption>{image.caption}<span>Source: {image.source}</span></figcaption>
        </figure>
      ))}
    </section>
  )}

  <div class="stack">
    {project.stack.map((s) => <span class="tag">{s}</span>)}
  </div>
</article>

<style>
  .sheet {
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: rgba(13, 40, 70, 0.4);
    padding: 1.5rem 1.75rem;
    margin-bottom: 2.5rem;
  }

  .title-block {
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .tb-row { margin-bottom: 0.3rem; }
  .tb-split { display: flex; gap: 2rem; flex-wrap: wrap; }
  .tb-label { color: var(--line); margin-right: 0.5rem; }
  .tb-value { color: var(--line-bright); font-weight: 600; }

  .tagline {
    color: var(--line-bright);
    font-size: 1.05rem;
    margin: 0 0 1rem;
  }

  .pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: 1.25rem;
  }
  .pipe-step {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
  }
  .pipe-arrow { color: var(--accent); }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 1rem;
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
    padding: 1rem 0;
    margin-bottom: 1.25rem;
  }
  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--accent);
  }
  .metric-label {
    font-size: 0.7rem;
    color: var(--line);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .summary {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--line-bright);
    margin-bottom: 1.25rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .summary p { margin: 0 0 1rem; }
  .project-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin: 1.75rem 0; }
  .project-gallery figure { min-width: 0; margin: 0; }
  .project-gallery figure:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .project-gallery a { display: flex; align-items: center; justify-content: center; background: var(--paper); border-radius: 6px; overflow: hidden; min-height: 180px; }
  .project-gallery a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .project-gallery img { display: block; width: 100%; height: auto; max-height: 480px; object-fit: contain; }
  .project-gallery figcaption { padding-top: 0.65rem; font-size: 0.85rem; line-height: 1.5; }
  .project-gallery figcaption span { display: block; color: var(--line); font-size: 0.75rem; margin-top: 0.25rem; }
  @media (max-width: 600px) { .project-gallery { grid-template-columns: minmax(0, 1fr); } }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--line);
    padding: 0.2rem 0.5rem;
  }
</style>
